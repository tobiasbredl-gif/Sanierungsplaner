<Window x:Class="Sanierungsplaner.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sanierungsplaner" Width="1100" Height="740" Style="{StaticResource {x:Type Window}}"
        MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen"
        Language="de-DE">
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#153E33" Padding="24,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="S /" Foreground="#B9D8AB" FontSize="36" FontWeight="Bold" />
                    <TextBlock Text="Sanierungsplaner" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="PLATZ FÜR VERÄNDERUNG" Foreground="#BDD0C8" FontSize="10" Margin="0,0,0,40" />
                    <Button Content="_Übersicht" Command="{Binding ShowHomeCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                    <Button Content="Über die _App" Command="{Binding ShowAboutCommand}" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="WINDOWS DESKTOP" Foreground="#BDD0C8" FontSize="11" />
                    <TextBlock Text="Grundgerüst · 0.1.0" Foreground="White" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="40,32">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,36">
                <TextBlock Text="DEIN ARBEITSPLATZ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" Background="#E3EBDE" CornerRadius="12" Padding="12,5">
                    <TextBlock Text="Lokal · ohne Anmeldung" FontSize="11" />
                </Border>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="Schritt für Schritt zu einem durchdachten Sanierungsplan." Foreground="#596B62" FontSize="12" Margin="0,24,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="36" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <TextBlock Text="{Binding PageDescription}" FontSize="16" Foreground="#596B62" LineHeight="26" Margin="0,0,0,32" />
                    <Border Background="White" BorderBrush="#DDE4DC" BorderThickness="1" CornerRadius="12" Padding="28">
                        <StackPanel>
                            <TextBlock Text="Das Fundament steht." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Diese erste Version startet als eigenständige Desktop-App. Über die Navigation kannst du zwischen Übersicht und App-Informationen wechseln." Foreground="#596B62" LineHeight="23" />
                            <Border Height="1" Background="#E4E9E2" Margin="0,24" />
                            <TextBlock Text="Nächster Ausbauschritt" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <TextBlock Text="Projektverwaltung, Maßnahmen und Kostenplanung können auf dieser Basis ergänzt werden. Diese Funktionen sind noch nicht enthalten." Foreground="#596B62" LineHeight="23" />
                            <TextBlock Text="Es werden noch keine Projektdaten gespeichert." FontSize="12" Foreground="#596B62" Margin="0,20,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
