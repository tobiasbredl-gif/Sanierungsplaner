<Window x:Class="Sanierungsplaner.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Sanierungsplaner.Desktop.Views"
        Title="Sanierungsplaner" Width="1120" Height="820" Style="{StaticResource {x:Type Window}}"
        MinWidth="780" MinHeight="580" WindowStartupLocation="CenterScreen" Language="de-DE">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DDE4DC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="24" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#9EAEA4" />
            <Setter Property="Background" Value="#FCFDFC" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#E3EBDE" />
            <Setter Property="Foreground" Value="#153E33" />
        </Style>
    </Window.Resources>
    <Grid Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="232" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="#153E33" Padding="24,32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="S /" Foreground="#B9D8AB" FontSize="36" FontWeight="Bold" />
                    <TextBlock Text="Sanierungsplaner" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <TextBlock Text="PLATZ FÜR VERÄNDERUNG" Foreground="#BDD0C8" FontSize="10" Margin="0,0,0,40" />
                    <Button Content="_Projekte" Command="{Binding ShowHomeCommand}" HorizontalContentAlignment="Left" Margin="0,0,0,10" />
                    <Button Content="Über die _App" Command="{Binding ShowAboutCommand}" HorizontalContentAlignment="Left" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="WINDOWS DESKTOP" Foreground="#BDD0C8" FontSize="11" />
                    <TextBlock Text="Kostenübersicht · 0.5.1" Foreground="White" Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="32,28">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,24">
                <TextBlock Text="DEIN ARBEITSPLATZ" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" Background="#E3EBDE" CornerRadius="12" Padding="12,5">
                    <TextBlock Text="Lokal · ohne Anmeldung" FontSize="11" />
                </Border>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="#176B56" FontSize="12" Margin="0,16,0,0" AutomationProperties.LiveSetting="Polite" />
            <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="{Binding ShowEditor, Converter={StaticResource VisibleWhenTrue}}">
                <Button x:Name="SaveProjectButton" Content="Projekt _speichern" Command="{Binding SaveProjectCommand}" Margin="0,0,16,8" />
                <TextBlock Text="{Binding DraftStatus}" VerticalAlignment="Center" Foreground="#596B62" FontSize="12" Margin="0,0,0,8" />
            </WrapPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{Binding PageTitle}" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding PageDescription}" FontSize="15" Foreground="#596B62" LineHeight="24" Margin="0,0,0,24" />
                    <Border Background="#FFF0E9" BorderBrush="#C67858" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16" Visibility="{Binding HasError, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Text="{Binding Error}" Foreground="#852D14" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <StackPanel Visibility="{Binding ShowProjects, Converter={StaticResource VisibleWhenTrue}}">
                        <WrapPanel Margin="0,0,0,20">
                            <Button x:Name="NewProjectButton" Content="+ _Neues Projekt" Command="{Binding NewProjectCommand}" Margin="0,0,12,8" />
                            <Button Content="Erneut laden" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                        </WrapPanel>
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Dein Vorhaben beginnt hier." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <TextBlock Text="Noch keine Projekte vorhanden. Starte mit einem Namen und ergänze die Adresse und deine ersten Ideen." Foreground="#596B62" LineHeight="24" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ProjectCount}" Foreground="#596B62" FontSize="12" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding AddressLabel}" Foreground="#596B62" Margin="0,8,0,12" />
                                            <TextBlock Text="{Binding UpdatedLabel}" Foreground="#596B62" FontSize="12" Margin="0,0,0,16" />
                                            <Button Content="Projekt öffnen" HorizontalAlignment="Left" Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowEditor, Converter={StaticResource VisibleWhenTrue}}">
                        <Button Content="← Alle Projekte" Command="{Binding BackCommand}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Margin="0,0,0,16" />
                        <TabControl x:Name="ProjectTabs" Background="Transparent" BorderThickness="0" Padding="0,16,0,0">
                            <TabItem Header="Projektdaten" Padding="16,10">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Label Content="Projekt_name *" Target="{Binding ElementName=ProjectName}" Padding="0" Margin="0,0,0,8" />
                                <TextBox x:Name="ProjectName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="120" AutomationProperties.Name="Projektname" />
                                <Label Content="_Objektadresse" Target="{Binding ElementName=ProjectAddress}" Padding="0" Margin="0,20,0,8" />
                                <TextBox x:Name="ProjectAddress" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="300" AutomationProperties.Name="Objektadresse" />
                                <Label Content="Noti_zen" Target="{Binding ElementName=ProjectNotes}" Padding="0" Margin="0,20,0,8" />
                                <TextBox x:Name="ProjectNotes" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" Height="130" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Notizen" />
                                <TextBlock Text="* Pflichtfeld · Adresse und Notizen sind optional." Foreground="#596B62" FontSize="12" Margin="0,12,0,20" />
                            </StackPanel>
                        </Border>
                            </TabItem>
                            <TabItem Header="Kosten &amp; Zahlungen" Padding="16,10"><views:CostPlanView DataContext="{Binding CostPlan}" /></TabItem>
                        </TabControl>
                    </StackPanel>
                    <Border Style="{StaticResource Card}" Visibility="{Binding ShowAbout, Converter={StaticResource VisibleWhenTrue}}">
                        <StackPanel>
                            <TextBlock Text="Ein Zuhause für deine Projekte." FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <TextBlock Text="Verwalte deine Projekte, kalkuliere Kosten und halte fest, was Lea, Wolfgang, Jennifer und Tobias bezahlt haben. Alles bleibt lokal gespeichert." Foreground="#596B62" LineHeight="24" />
                            <TextBlock Text="Dein Speicherordner" FontWeight="SemiBold" Margin="0,24,0,8" />
                            <TextBox Text="{Binding StoragePath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Speicherordner" />
                            <TextBlock Text="Die Daten liegen als lesbare Dateien auf diesem Computer. Sichere diesen Ordner bei Bedarf. Es gibt noch keine Cloud-Synchronisierung oder automatische Sicherung." Foreground="#596B62" Margin="0,12,0,20" LineHeight="24" />
                            <TextBlock Text="Weitere Ausbauschritte: Excel-Export und eine gekoppelte Android-App." FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
