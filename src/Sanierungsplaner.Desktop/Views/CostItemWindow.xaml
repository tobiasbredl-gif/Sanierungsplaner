<Window x:Class="Sanierungsplaner.Desktop.Views.CostItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kostenposition" Width="660" Height="800" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner" Style="{StaticResource {x:Type Window}}" Language="de-DE">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,5" /><Setter Property="Margin" Value="0,3,0,8" /><Setter Property="FontSize" Value="14" /></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,5" /><Setter Property="Margin" Value="0,3,0,8" /></Style>
    </Window.Resources>
    <Grid Background="#F4F6F3"><DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Eine Position. Alle Zahlungen." FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Alle Beträge in Euro. Raum und Etage sind optional." Foreground="#596B62" Margin="0,8,0,0" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding Error}" Foreground="#852D14" Margin="0,12" AutomationProperties.LiveSetting="Assertive" />
            <WrapPanel>
                <Button x:Name="ApplyButton" Content="Position übernehmen" Click="Apply" Margin="0,0,12,0" />
                <Button Content="Abbrechen" IsCancel="True" />
            </WrapPanel>
            <TextBlock Text="Danach das Projekt speichern, um die Änderung dauerhaft zu sichern." FontSize="12" Margin="0,12,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Material / Beschreibung *" />
                <TextBox x:Name="MaterialInput" Text="{Binding [Material], UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="Material oder Beschreibung" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Etage" /><TextBox Text="{Binding [Floor], UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Etage" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Raum" /><TextBox Text="{Binding [Room], UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="Raum" /></StackPanel>
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Menge *" /><TextBox x:Name="QuantityInput" Text="{Binding [Quantity], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Menge" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Einheit *" /><TextBox Text="{Binding [Unit], UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.Name="Einheit" /></StackPanel>
                    <StackPanel Grid.Column="4"><TextBlock Text="Einzelpreis (€) *" /><TextBox x:Name="PriceInput" Text="{Binding [UnitPrice], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Einzelpreis" /></StackPanel>
                </Grid>
                <TextBlock Text="{Binding TotalLabel}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                <TextBlock Text="Status" />
                <ComboBox x:Name="StatusInput" ItemsSource="{Binding Statuses}" SelectedItem="{Binding [Status], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Status" />
                <TextBlock Text="Wer hat was bezahlt?" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8" />
                <TextBlock Text="Nur tatsächlich bezahlte Beträge eintragen. Teilzahlungen und gemeinsame Zahlungen sind möglich; 0,00 bedeutet noch nichts bezahlt." Foreground="#596B62" Margin="0,0,0,16" />
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                    <TextBlock Text="Lea" VerticalAlignment="Center" /><TextBox x:Name="LeaInput" Grid.Column="1" Text="{Binding [Lea], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezahlt von Lea" />
                    <TextBlock Grid.Row="1" Text="Wolfgang" VerticalAlignment="Center" /><TextBox x:Name="WolfgangInput" Grid.Row="1" Grid.Column="1" Text="{Binding [Wolfgang], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezahlt von Wolfgang" />
                    <TextBlock Grid.Row="2" Text="Jennifer" VerticalAlignment="Center" /><TextBox x:Name="JenniferInput" Grid.Row="2" Grid.Column="1" Text="{Binding [Jennifer], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezahlt von Jennifer" />
                    <TextBlock Grid.Row="3" Text="Tobias" VerticalAlignment="Center" /><TextBox x:Name="TobiasInput" Grid.Row="3" Grid.Column="1" Text="{Binding [Tobias], UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bezahlt von Tobias" />
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel></Grid>
</Window>
