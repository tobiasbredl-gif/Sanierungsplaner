<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>de.sanierungsplaner.android</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>0.12.0</ApplicationDisplayVersion>
    <ApplicationTitle>Sanierungsplaner</ApplicationTitle>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidLinkMode>None</AndroidLinkMode>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Sanierungsplaner.SharedSync/*.cs" Link="SyncShared/%(Filename)%(Extension)" />
    <!-- Shared source is intentional: Android uses the tested desktop rules without a WPF dependency. -->
    <Compile Include="../Sanierungsplaner.Desktop/Models/*.cs" Link="Shared/Models/%(Filename)%(Extension)" />
    <Compile Include="../Sanierungsplaner.Desktop/ViewModels/*.cs" Link="Shared/ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../Sanierungsplaner.Desktop/Commands/*.cs" Link="Shared/Commands/%(Filename)%(Extension)" />
    <Compile Include="../Sanierungsplaner.Desktop/Services/I*.cs" Exclude="../Sanierungsplaner.Desktop/Services/IncomingRepaymentEditor.cs" Link="Shared/Services/%(Filename)%(Extension)" />
    <Compile Include="../Sanierungsplaner.Desktop/Services/JsonProjectStore.cs" Link="Shared/Services/JsonProjectStore.cs" />
    <Compile Include="../Sanierungsplaner.Desktop/Services/CostItemMatching.cs" Link="Shared/Services/CostItemMatching.cs" />
  </ItemGroup>
</Project>
